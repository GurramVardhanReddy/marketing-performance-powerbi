{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "trend_cost",
  "position": {
    "x": 660,
    "y": 150,
    "z": 0,
    "width": 600,
    "height": 270
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "day_index"
                }
              },
              "queryRef": "dim_date.day_index",
              "nativeQueryRef": "day_index"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Cumulative Cost"
                }
              },
              "queryRef": "Key Measures.Cumulative Cost",
              "nativeQueryRef": "Cumulative Cost"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Cumulative cost'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
