{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "tier_mix",
  "position": {
    "x": 660,
    "y": 440,
    "z": 0,
    "width": 600,
    "height": 260
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_campaign"
                    }
                  },
                  "Property": "current_spend_tier"
                }
              },
              "queryRef": "dim_campaign.current_spend_tier",
              "nativeQueryRef": "current_spend_tier"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Cost"
                }
              },
              "queryRef": "Key Measures.Cost",
              "nativeQueryRef": "Cost"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Attributed Conversions"
                }
              },
              "queryRef": "Key Measures.Attributed Conversions",
              "nativeQueryRef": "Attributed Conversions"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Cost and attributed conversions by current spend tier'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
