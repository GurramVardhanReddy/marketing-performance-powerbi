table dim_date

	column day_index
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_index

	column week_index
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: week_index

	column day_of_week_index
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_week_index

	column in_impression_window
		dataType: boolean
		summarizeBy: none
		sourceColumn: in_impression_window

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\dim_date.parquet"))
				in
				    Source

